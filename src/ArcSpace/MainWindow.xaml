<Window x:Class="ArcSpace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ArcSpace.Models"
        Title="ArcSpace"
        Width="1280" Height="820"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:ScanItem}" ItemsSource="{Binding Children}">
            <Grid Height="36" Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="74"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="14"
                               Foreground="#5E6C84" VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="{Binding FileCountDisplay}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,20,28,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentBrush}" Margin="0,0,11,0">
                            <TextBlock Text="&#xE7F8;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ArcSpace" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Find what is consuming disk space. Fast." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="11,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="PORTABLE TECHNICIAN UTILITY" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,22,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="385"/>
                </Grid.RowDefinitions>

                <!-- Scan target + disk summary -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SCAN TARGET" Style="{StaticResource EyebrowStyle}"/>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="DriveCombo" Grid.Column="0" MinWidth="220" Margin="0,0,8,0"
                                          DisplayMemberPath="Display" SelectionChanged="DriveCombo_SelectionChanged"/>
                                <Button x:Name="ChooseFolderButton" Grid.Column="1" Content="Choose folder" Style="{StaticResource BaseButtonStyle}"
                                        Click="ChooseFolder_Click" Margin="0,0,8,0"/>
                                <Button x:Name="ScanButton" Grid.Column="2" Content="Scan now" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ScanButton_Click" MinWidth="92" Margin="0,0,8,0"/>
                                <Button x:Name="StopButton" Grid.Column="3" Content="Stop" Style="{StaticResource DangerButtonStyle}"
                                        Click="StopButton_Click" IsEnabled="False" MinWidth="72"/>
                            </Grid>
                            <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="7" Margin="0,10,0,0" Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="PathText" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DISK HEALTH" Style="{StaticResource EyebrowStyle}"/>
                                <Border x:Name="ScanStateBadge" Grid.Column="1" Background="{StaticResource SuccessSoftBrush}" CornerRadius="10" Padding="8,3">
                                    <TextBlock x:Name="ScanStateText" Text="READY" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DiskSummaryText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DiskPercentText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0"/>
                            </Grid>
                            <ProgressBar x:Name="DiskUsageBar" Margin="0,11,0,0" Minimum="0" Maximum="100"/>
                            <ProgressBar x:Name="ScanActivityBar" Margin="0,7,0,0" Height="3" IsIndeterminate="True" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metrics -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="USED SPACE" Style="{StaticResource EyebrowStyle}"/>
                            <TextBlock x:Name="UsedSpaceText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                            <TextBlock Text="On selected drive" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="FREE SPACE" Style="{StaticResource EyebrowStyle}"/>
                            <TextBlock x:Name="FreeSpaceText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                            <TextBlock Text="Available now" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="FILES SCANNED" Style="{StaticResource EyebrowStyle}"/>
                            <TextBlock x:Name="FilesScannedText" Text="0" Style="{StaticResource MetricValueStyle}"/>
                            <TextBlock x:Name="DirectoriesScannedText" Text="0 folders" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SKIPPED" Style="{StaticResource EyebrowStyle}"/>
                            <TextBlock x:Name="SkippedText" Text="0" Style="{StaticResource MetricValueStyle}"/>
                            <TextBlock Text="Protected / reparse entries" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Section headings -->
                <Grid Grid.Row="2" Margin="2,0,2,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.92*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Folder breakdown" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock x:Name="FolderSubtitleText" Text="Largest folders first, with file counts" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Largest files" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="FilesSubtitleText" Text="Top 100 files discovered during this scan" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button x:Name="FilterAllButton" Content="All" Style="{StaticResource ActiveFilterButtonStyle}" Click="FilterAll_Click"/>
                            <Button x:Name="Filter100Button" Content="> 100 MB" Style="{StaticResource FilterButtonStyle}" Click="Filter100_Click"/>
                            <Button x:Name="Filter500Button" Content="> 500 MB" Style="{StaticResource FilterButtonStyle}" Click="Filter500_Click"/>
                            <Button x:Name="Filter1GbButton" Content="> 1 GB" Style="{StaticResource FilterButtonStyle}" Click="Filter1Gb_Click" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Main analysis panes -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.92*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                                <Grid Margin="29,0,14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="74"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="FOLDER" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="SIZE" Style="{StaticResource EyebrowStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="FILES" Style="{StaticResource EyebrowStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <TreeView x:Name="FolderTree"
                                          Margin="12,8,12,12"
                                          KeyDown="FolderTree_KeyDown"
                                          PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open in Explorer" InputGestureText="Enter" Click="OpenFolderItem_Click"/>
                                            <MenuItem Header="Copy path" InputGestureText="Ctrl+C" Click="CopyFolderPath_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Delete folder..." Click="DeleteFolder_Click" Foreground="{StaticResource DangerBrush}"/>
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                </TreeView>
                                <StackPanel x:Name="FolderEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="FolderEmptyTitle" Text="Nothing scanned yet" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock x:Name="FolderEmptySubtitle" Text="Choose a drive or folder, then start a scan." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <DataGrid x:Name="LargestFilesGrid"
                                      KeyDown="LargestFilesGrid_KeyDown"
                                      PreviewMouseRightButtonDown="LargestFilesGrid_PreviewMouseRightButtonDown"
                                      MouseDoubleClick="LargestFilesGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FILE" Binding="{Binding Name}" Width="1.45*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="SIZE" Binding="{Binding SizeDisplay}" Width="92">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="PATH" Binding="{Binding FullPath}" Width="2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Show in Explorer" InputGestureText="Enter" Click="ShowFileInExplorer_Click"/>
                                        <MenuItem Header="Copy path" InputGestureText="Ctrl+C" Click="CopyFilePath_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Delete file..." Click="DeleteFile_Click" Foreground="{StaticResource DangerBrush}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                            <StackPanel x:Name="FilesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="FilesEmptyTitle" Text="Waiting for scan" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock x:Name="FilesEmptySubtitle" Text="Large files will appear here automatically." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready to scan" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="StatusDetailsText" Text="0 files  ·  0 folders  ·  0 B  ·  00:00" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="VersionText" Text="   ArcSpace" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
