<Window x:Class="ArcSpace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcSpace.Controls"
        xmlns:models="clr-namespace:ArcSpace.Models"
        Title="ArcSpace"
        Width="1420" Height="900"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:ScanItem}" ItemsSource="{Binding Children}">
            <Grid Height="30" MinWidth="620">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="78"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,8,0">
                    <TextBlock Text="&#xE8B7;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="13"
                               Foreground="#F2C94C"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding Name}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FullPath}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding SizeDisplay}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="SemiBold"
                           FontSize="11.5"
                           Margin="0,0,12,0"/>

                <Grid Grid.Column="2" Margin="8,6,10,6">
                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{Binding UsagePercent}"
                                 Style="{StaticResource UsageBarStyle}"/>
                    <TextBlock Text="{Binding UsageDisplay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="9.5"
                               FontWeight="SemiBold"/>
                </Grid>

                <TextBlock Grid.Column="3"
                           Text="{Binding FileCountDisplay}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           Margin="0,0,10,0"/>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="68"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="29"/>
        </Grid.RowDefinitions>

        <!-- Compact application header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="13,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="27" Height="27" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,9,0">
                        <TextBlock Text="&#xE7F8;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ArcSpace"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  /  DISK SPACE ANALYZER"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="F5 scan  ·  Esc stop  ·  Enter open  ·  Ctrl+C copy path"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           FontSize="10.5"/>

                <Border x:Name="ScanStateBadge"
                        Grid.Column="2"
                        Background="{StaticResource SuccessSoftBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="9,3"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="6" Height="6"
                                 Fill="{StaticResource SuccessBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock x:Name="ScanStateText"
                                   Text="READY"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <Button x:Name="UpdatesButton"
                        Grid.Column="3"
                        Content="Updates"
                        Style="{StaticResource HeaderButtonStyle}"
                        ToolTip="Update settings (Ctrl+U)"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Command bar -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="3"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="245"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="285"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="DriveCombo"
                              Grid.Column="0"
                              DisplayMemberPath="Display"
                              SelectionChanged="DriveCombo_SelectionChanged"
                              Margin="0,0,8,0"/>

                    <Button x:Name="ChooseFolderButton"
                            Grid.Column="1"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="ChooseFolder_Click"
                            Margin="0,0,7,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Select folder"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ScanButton"
                            Grid.Column="2"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ScanButton_Click"
                            MinWidth="82"
                            Height="38"
                            Margin="0,0,7,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Scan"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="StopButton"
                            Grid.Column="3"
                            Content="Stop"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="StopButton_Click"
                            IsEnabled="False"
                            MinWidth="72"
                            Height="38"/>

                    <Border Grid.Column="5"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="12"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="PathText"
                                       Grid.Column="1"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="7" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DiskSummaryText"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DiskPercentText"
                                       Grid.Column="1"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#93C5FD"
                                       Margin="10,0,0,0"/>
                        </Grid>
                        <ProgressBar x:Name="DiskUsageBar" Margin="0,7,0,0" Minimum="0" Maximum="100"/>
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="ScanActivityBar"
                             Grid.Row="1"
                             Style="{StaticResource ScanProgressBarStyle}"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Dense scan summary -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SummaryCellStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#60A5FA" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="USED SPACE" Style="{StaticResource EyebrowStyle}"/>
                            <TextBlock x:Name="UsedSpaceText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SummaryCellStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#34D399" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="FREE SPACE" Style="{StaticResource EyebrowStyle}"/>
                            <TextBlock x:Name="FreeSpaceText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SummaryCellStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#A78BFA" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ANALYZED" Style="{StaticResource EyebrowStyle}"/>
                            <TextBlock x:Name="AnalyzedSpaceText" Text="0 B" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource SummaryCellStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#FBBF24" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="DISCOVERED" Style="{StaticResource EyebrowStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FilesScannedText" Text="0" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text=" files  ·  " FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                <TextBlock x:Name="DirectoriesScannedText" Text="0 folders" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource SummaryCellStyle}" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#F87171" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SKIPPED" Style="{StaticResource EyebrowStyle}"/>
                            <TextBlock x:Name="SkippedText" Text="0" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Analysis workspace -->
        <Grid Grid.Row="3" Margin="9">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="330"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="205" MinHeight="130"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" MinWidth="610"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="0.85*" MinWidth="390"/>
                </Grid.ColumnDefinitions>

                <!-- Folder hierarchy -->
                <Border Grid.Column="0" Style="{StaticResource PaneStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="43"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="5,5,0,0">
                            <Grid Margin="11,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Folder hierarchy" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock x:Name="FolderSubtitleText"
                                               Text="Largest folders first, with file counts"
                                               FontSize="10"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="SIZE BARS SHOW % OF PARENT"
                                           Style="{StaticResource EyebrowStyle}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="17,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="132"/>
                                    <ColumnDefinition Width="78"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="SIZE" Style="{StaticResource EyebrowStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="% OF PARENT" Style="{StaticResource EyebrowStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="FILES" Style="{StaticResource EyebrowStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <TreeView x:Name="FolderTree"
                                      KeyDown="FolderTree_KeyDown"
                                      PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open in Explorer" InputGestureText="Enter" Click="OpenFolderItem_Click"/>
                                        <MenuItem Header="Copy path" InputGestureText="Ctrl+C" Click="CopyFolderPath_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Delete folder..." Click="DeleteFolder_Click" Foreground="{StaticResource DangerBrush}"/>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>

                            <StackPanel x:Name="FolderEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock Text="&#xE8B7;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="24"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FolderEmptyTitle"
                                           Text="Nothing scanned yet"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                                <TextBlock x:Name="FolderEmptySubtitle"
                                           Text="Choose a drive or folder, then start a scan."
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Style="{StaticResource GridSplitterStyle}"/>

                <!-- Largest files -->
                <Border Grid.Column="2" Style="{StaticResource PaneStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="43"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="5,5,0,0">
                            <Grid Margin="11,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Largest files" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock x:Name="FilesSubtitleText"
                                               Text="Top 100 files discovered during this scan"
                                               FontSize="10"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="FilterAllButton" Content="All" Style="{StaticResource ActiveFilterButtonStyle}" Click="FilterAll_Click"/>
                                    <Button x:Name="Filter100Button" Content=">100 MB" Style="{StaticResource FilterButtonStyle}" Click="Filter100_Click"/>
                                    <Button x:Name="Filter500Button" Content=">500 MB" Style="{StaticResource FilterButtonStyle}" Click="Filter500_Click"/>
                                    <Button x:Name="Filter1GbButton" Content=">1 GB" Style="{StaticResource FilterButtonStyle}" Click="Filter1Gb_Click" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <DataGrid x:Name="LargestFilesGrid"
                                      KeyDown="LargestFilesGrid_KeyDown"
                                      PreviewMouseRightButtonDown="LargestFilesGrid_PreviewMouseRightButtonDown"
                                      MouseDoubleClick="LargestFilesGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="FILE" SortMemberPath="Name" Width="1.25*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8A5;"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FullPath}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="SIZE" Binding="{Binding SizeDisplay}" SortMemberPath="SizeBytes" Width="92">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="TYPE" SortMemberPath="ExtensionDisplay" Width="66">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource AccentSoftBrush}"
                                                        BorderBrush="{StaticResource AccentBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="5,2"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ExtensionDisplay}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="#93C5FD"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="FOLDER" Binding="{Binding ParentPathDisplay}" Width="1.15*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                                                <Setter Property="FontSize" Value="10"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="ToolTip" Value="{Binding FullPath}"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>

                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Show in Explorer" InputGestureText="Enter" Click="ShowFileInExplorer_Click"/>
                                        <MenuItem Header="Copy path" InputGestureText="Ctrl+C" Click="CopyFilePath_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Delete file..." Click="DeleteFile_Click" Foreground="{StaticResource DangerBrush}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>

                            <StackPanel x:Name="FilesEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="24"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FilesEmptyTitle"
                                           Text="Waiting for scan"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                                <TextBlock x:Name="FilesEmptySubtitle"
                                           Text="Large files will appear here automatically."
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Style="{StaticResource GridSplitterStyle}"/>

            <!-- WinDirStat-style top-level space map -->
            <Border Grid.Row="2" Style="{StaticResource PaneStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="5,5,0,0">
                        <Grid Margin="11,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Space map" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="  ·  largest top-level folders; relative area follows discovered bytes"
                                           FontSize="10"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="SpaceMapStateBadge"
                                    Grid.Column="1"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="SpaceMapStateText"
                                           Text="WAITING"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <controls:FolderTreemap x:Name="SpaceMap"
                                            Grid.Row="1"
                                            EmptyText="Start a scan to build the top-level space map."
                                            ItemInvoked="SpaceMap_ItemInvoked"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="Ready to scan"
                           FontSize="10.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusDetailsText"
                           Grid.Column="1"
                           Text="0 files  ·  0 folders  ·  0 B  ·  00:00"
                           FontSize="10.5"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText"
                           Grid.Column="2"
                           Text="   ArcSpace"
                           FontSize="10.5"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
