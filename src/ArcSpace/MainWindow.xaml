<Window x:Class="ArcSpace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ArcSpace.Models"
        Title="ArcSpace" Height="760" Width="1120" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7E9ED"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:ScanItem}" ItemsSource="{Binding Children}">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="{Binding FileCountDisplay}" HorizontalAlignment="Right" Foreground="#667085"/>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ArcSpace" FontSize="28" FontWeight="Bold" Foreground="#101828"/>
                <TextBlock Text="Fast disk-space analysis for Windows technicians" Foreground="#667085" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF2FF" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                <TextBlock Text="PORTABLE" Foreground="#175CD3" FontWeight="Bold" FontSize="11"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="DriveCombo" Width="220" Height="36" Margin="0,0,10,0"
                              DisplayMemberPath="Display" SelectionChanged="DriveCombo_SelectionChanged"/>
                    <Button x:Name="ScanButton" Content="Scan" Click="ScanButton_Click" Background="#175CD3" Foreground="White" BorderBrush="#175CD3"/>
                    <Button Content="Choose folder" Click="ChooseFolder_Click"/>
                    <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="PathText" Grid.Row="1" Margin="2,10,0,0" Foreground="#475467" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DiskSummaryText" FontWeight="SemiBold" Foreground="#344054"/>
                    <TextBlock x:Name="DiskPercentText" Grid.Column="1" Foreground="#667085"/>
                </Grid>
                <ProgressBar x:Name="DiskUsageBar" Grid.Row="1" Height="10" Margin="0,10,0,0" Minimum="0" Maximum="100"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10">
            <TabControl BorderThickness="0">
                <TabItem Header="Folders">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="24,0,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Folder" FontWeight="SemiBold" Foreground="#475467"/>
                            <TextBlock Grid.Column="1" Text="Size" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#475467" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="Files" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#475467"/>
                        </Grid>
                        <TreeView x:Name="FolderTree" Grid.Row="1" BorderThickness="0"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open in Explorer" Click="OpenFolderItem_Click"/>
                                    <MenuItem Header="Copy path" Click="CopyFolderPath_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Delete folder..." Click="DeleteFolder_Click" Foreground="#B42318"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                    </Grid>
                </TabItem>
                <TabItem Header="Largest Files">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <TextBlock Text="Minimum size:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#667085"/>
                            <ComboBox x:Name="LargestFilterCombo" Width="140" Height="30" DisplayMemberPath="Display" SelectionChanged="LargestFilterCombo_SelectionChanged"/>
                        </StackPanel>
                        <DataGrid x:Name="LargestFilesGrid" Grid.Row="1" AutoGenerateColumns="False" MouseDoubleClick="LargestFilesGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*"/>
                                <DataGridTextColumn Header="Modified" Binding="{Binding LastModifiedDisplay}" Width="150"/>
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Show in Explorer" Click="ShowFileInExplorer_Click"/>
                                    <MenuItem Header="Copy path" Click="CopyFilePath_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Delete file..." Click="DeleteFile_Click" Foreground="#B42318"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="4" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#667085" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="ArcSpace v1.0" Foreground="#98A2B3"/>
        </Grid>
    </Grid>
</Window>
